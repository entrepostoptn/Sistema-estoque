# ==============================================================================
# SISTEMA DE CONTROLE DE ESTOQUE E ROMANEIOS - VARIÁVEIS DE AMBIENTE
# ==============================================================================

# Modo de Armazenamento: 'local' (100% offline / sem Google) ou 'firebase'
VITE_STORAGE_MODE=local

# ------------------------------------------------------------------------------
# Configurações do Firebase (Opcional - necessário apenas se for usar a Nuvem Firebase)
# Se deixar em branco, o sistema funciona 100% no Modo Local Autônomo.
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# Porta da aplicação web (padrão: 3000)
PORT=3000
